# Personal, local-only Jin10 MCP connection.
# Copy this file to .env.local and replace the placeholder locally.
JIN10_MCP_URL=https://mcp.jin10.com/mcp
JIN10_MCP_TOKEN=replace_with_your_private_token

# Web search is used only for bounded company and fund profile research.
# Keep this server-side key private; it is never sent to the browser or Ollama.
TAVILY_API_KEY=replace_with_your_private_tavily_key

# Fast structured company/ETF profile lookup. The free tier is sufficient for small cached portfolios.
# The key remains server-side and is never saved in profile evidence or sent to Ollama.
ALPHA_VANTAGE_API_KEY=replace_with_your_private_alpha_vantage_key

# Local Ollama models used by the relevance, research, impact, and review agents.
# Direct Mac development. Docker will use http://host.docker.internal:11434.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_RELEVANCE_MODEL=qwen3.5:4b
# Faster evidence extraction and first-pass impact analysis.
OLLAMA_RESEARCH_MODEL=qwen3.5:4b
OLLAMA_IMPACT_MODEL=qwen3.5:4b
# Keep the larger model only for the final independent review/audit.
OLLAMA_REVIEW_MODEL=qwen3.5:9b
# Legacy fallback retained for compatibility.
OLLAMA_MODEL=qwen3.5:9b
